 \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Pompa Galon Elektrik MIYAKO AWD-200 BK\",\n      \"kategori\": \"lainnya\",\n      \"nama_toko\": \"Fitrisyah3\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 75000,\n      \"harga_normal\": 75000,\n      \"diskon_pct\": 0.0,\n      \"tier_harga\": \"menengah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Tiebymin - Tyana Bergo Oval Syar'i Ukuran M\",\n      \"kategori\": \"lainnya\",\n      \"nama_toko\": \"tiebymin official\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 39999,\n      \"harga_normal\": 39999,\n      \"diskon_pct\": 0.0,\n      \"tier_harga\": \"bawah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": true\n    },\n    {\n      \"nama_produk\": \"[PREMIUM] Set Alat Makan Korea Stainless, Box Sendok Garpu Sumpit Gold\",\n      \"kategori\": \"rumah_tangga\",\n      \"nama_toko\": \"Abukastore Official\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 26000,\n      \"harga_normal\": 31325,\n      \"diskon_pct\": 17.0,\n      \"tier_harga\": \"bawah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": true\n    },\n    {\n      \"nama_produk\": \"Vaseline Lip Therapy ROSY LIPS 7gr - Pelembap Bibir - Lip Balm\",\n      \"kategori\": \"kecantikan\",\n      \"nama_toko\": \"Unilever Int. Shop ID\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 31150,\n      \"harga_normal\": 44500,\n      \"diskon_pct\": 30.0,\n      \"tier_harga\": \"bawah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Pigeon Teens Double Up Your Protection Sunscreen (Isi 2)\",\n      \"kategori\": \"kecantikan\",\n      \"nama_toko\": \"Pigeon Teens ID\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 65000,\n      \"harga_normal\": 90278,\n      \"diskon_pct\": 28.0,\n      \"tier_harga\": \"menengah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"keset kaki handuk hotel natural terry towel by chalmer 40x60 serap\",\n      \"kategori\": \"rumah_tangga\",\n      \"nama_toko\": \"SOPHILIA\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 31999,\n      \"harga_normal\": 31999,\n      \"diskon_pct\": 0.0,\n      \"tier_harga\": \"bawah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Biore Body Foam 800ML Fourpack Special Bundling\",\n      \"kategori\": \"lainnya\",\n      \"nama_toko\": \"KAO Indonesia\",\n      \"wilayah\": \"DKI Jakarta\",\n      \"harga\": 115500,\n      \"harga_normal\": 186290,\n      \"diskon_pct\": 38.0,\n      \"tier_harga\": \"menengah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Nathelabel - Plain Paris Japan Embroidery - Sand Embroidery\",\n      \"kategori\": \"lainnya\",\n      \"nama_toko\": \"Nathelabel\",\n      \"wilayah\": \"Jawa Barat\",\n      \"harga\": 66600,\n      \"harga_normal\": 95143,\n      \"diskon_pct\": 30.0,\n      \"tier_harga\": \"menengah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": false\n    },\n    {\n      \"nama_produk\": \"Reveline Liptint Stain Plump Tint (3,5ml) BPOM | Lip tint Bibir Gloss Lipstick Waterproof\",\n      \"kategori\": \"kecantikan\",\n      \"nama_toko\": \"Reveline Official\",\n      \"wilayah\": \"Jawa Barat\",\n      \"harga\": 50000,\n      \"harga_normal\": 76923,\n      \"diskon_pct\": 35.0,\n      \"tier_harga\": \"menengah\",\n      \"terjual\": 10000,\n      \"rating\": 4.9,\n      \"is_official_store\": true\n    },\n    {\n      \"nama_produk\": \"HMNS Perfume - Farhampton 100ml\",\n      \"kategori\": \"kecantikan\",\n      \"n